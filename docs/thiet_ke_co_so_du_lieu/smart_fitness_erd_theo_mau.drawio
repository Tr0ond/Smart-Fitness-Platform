      <mxCell id="ghi-chu-quyet-dinh" value="ĐÃ CHỐT — Chỉ tin Member thực sự kích hoạt kỳ mới tạo usage Chat. Tin sau hoặc kỳ đã được AI/QR/buổi PT kích hoạt: su_dung_quyen_loi_id=NULL. Mỗi tin vẫn kiểm tra quyền; không quota message, không trừ buổi." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="96" y="144" width="1560" height="66" as="geometry" /></mxCell></root>
    </mxGraphModel>
