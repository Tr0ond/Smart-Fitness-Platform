APP_NAME="Smart Fitness Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

AI_PROVIDER=unavailable
AI_MODEL=not-configured
AI_TIMEOUT_SECONDS=30
AI_PROPOSAL_TTL_HOURS=24
AI_IDEMPOTENCY_TTL_HOURS=24
AI_CANDIDATE_LIMIT=200

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/return
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOS_TIMEOUT_SECONDS=10
PAYOS_ORDER_TTL_MINUTES=30
PAYOS_IDEMPOTENCY_TTL_HOURS=24

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_fitness
DB_USERNAME=root
DB_PASSWORD=

# API Bearer-token policies; these are independent from Membership duration.
AUTH_TOKEN_LIFETIME_MINUTES=43200
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5

# Dynamic Gym check-in QR lifetime. Client requests cannot override this value.
GYM_QR_TTL_SECONDS=90

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Backend-only Laravel Reverb credentials. Generate non-example values per environment.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Optional local checkout used by ExerciseDatasetSeeder; never downloaded at runtime.
# EXERCISE_DATASET_PATH=../.tmp/exercises-dataset
# EXERCISE_DATASET_COMMIT=

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
