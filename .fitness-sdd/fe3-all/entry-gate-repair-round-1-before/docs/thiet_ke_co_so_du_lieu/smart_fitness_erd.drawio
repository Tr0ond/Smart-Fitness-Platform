        <mxCell id="26" value="   ngay_cap_nhat : DATETIME(6)" style="rounded=0;strokeColor=none;fillColor=#ffffff;fontFamily=Consolas;fontSize=9;align=left;spacingLeft=7;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="4" bang_du_lieu="su_kien_thanh_toan" cot_du_lieu="ngay_cap_nhat" kieu_du_lieu="DATETIME(6)" cho_phep_null="0" khoa_chinh="0" bang_tham_chieu="" cot_sinh="" nhom_unique="[]" tooltip="DATETIME(6); NOT NULL; &#10;Thời điểm cập nhật, UTC.">
