        <mxCell id="q-col-hoi_vien_dang_phan_cong_id" value="   hoi_vien_dang_phan_cong_id : BIGINT UNSIGNED ? [U4] [G]" style="rounded=0;strokeColor=none;fillColor=#ffffff;fontFamily=Consolas;fontSize=9;align=left;spacingLeft=7;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="4" bang_du_lieu="phan_cong_huan_luyen_vien" cot_du_lieu="hoi_vien_dang_phan_cong_id" kieu_du_lieu="BIGINT UNSIGNED" cho_phep_null="1" khoa_chinh="0" bang_tham_chieu="" cot_sinh="VIRTUAL" nhom_unique="[4]" tooltip="BIGINT UNSIGNED; NULL; U4(hoi_vien_dang_phan_cong_id)&#10;Cột sinh VIRTUAL: bằng hoi_vien_id khi ngay_ket_thuc IS NULL; ngược lại NULL. UNIQUE chỉ bảo vệ tối đa một khoảng phân công mở, không tự bảo vệ mọi overlap theo thời gian.">
          <mxGeometry x="0" y="141" width="420.0" height="15" as="geometry" />
        </mxCell>
        <mxCell id="q-rang-buoc" parent="1" vertex="1" value="Lịch sử quan hệ phụ trách PT–Member theo khoảng hiệu lực.&#10;U1 = (hoi_vien_id, huan_luyen_vien_id, ngay_bat_dau)&#10;U2 = (id, hoi_vien_id, huan_luyen_vien_id)&#10;U3 = (id, hoi_vien_id)&#10;U4 = (hoi_vien_dang_phan_cong_id)&#10;CHECK cùng hàng: ngay_ket_thuc NULL hoặc &gt; ngay_bat_dau.&#10;Index bổ sung: (hoi_vien_id, ngay_bat_dau, ngay_ket_thuc); (huan_luyen_vien_id, ngay_bat_dau, ngay_ket_thuc)&#10;G — hoi_vien_dang_phan_cong_id: Cột sinh VIRTUAL: bằng hoi_vien_id khi ngay_ket_thuc IS NULL; ngược lại NULL. UNIQUE chỉ bảo vệ tối đa một khoảng phân công mở, không tự bảo vệ mọi overlap theo thời gian.&#10;Q04 ĐÃ CHỐT: mỗi Member có 0..1 PT hiệu lực tại một thời điểm, nhưng có nhiều phân công lịch sử. Không cho overlap giữa BẤT KỲ PT nào cùng Member, dùng khoảng [ngay_bat_dau, ngay_ket_thuc), NULL là không có cận cuối. Khóa ho_so_hoi_vien trước rồi các phân công theo id; đọc lại toàn bộ khoảng liên quan, loại hàng đang sửa và kiểm tra giao khoảng trước khi ghi. Index (hoi_vien_id, ngay_bat_dau, ngay_ket_thuc) hỗ trợ truy vấn. Đổi PT đóng khoảng cũ trước hoặc đúng lúc mở khoảng mới trong cùng transaction + audit; giữ hàng cũ. UNIQUE cột sinh chỉ ngăn hai hàng có ngày kết thúc NULL, kể cả hàng mở ở tương lai; không phát hiện overlap hai khoảng hữu hạn hoặc khoảng mở với khoảng hữu hạn. Không có CHECK chéo hàng và không dùng NOW() trong cột sinh. Q05: hội thoại tham chiếu đúng lần phân công; phân công kết thúc làm hội thoại cũ chỉ đọc cho Member. Không gắn phân công vào một kỳ Membership; Q13 Proposal chỉ cần phân công hợp lệ, còn Chat/buổi trực tiếp kiểm tra quyền kỳ riêng." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=10;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontColor=#172b4d;">
          <mxGeometry x="40" y="360" width="720.0" height="288" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bang-23" name="B23 lich_su_su_dung_huan_luyen_vien">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="804" math="0" shadow="0" trang_thai_thiet_ke="APPROVED_FOR_MIGRATION_PLANNING">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="B23  lich_su_su_dung_huan_luyen_vien" style="text;html=0;align=left;fontSize=20;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="720" height="28" as="geometry" />
        </mxCell>
        <mxCell id="3" value="APPROVED FOR MIGRATION PLANNING • Q01–Q13 đã chốt • Chưa tạo/chạy migration" style="text;html=0;align=left;fontSize=10;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="720" height="20" as="geometry" />
        </mxCell>
        <mxCell id="4" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#2e6f40;strokeWidth=1.5;" vertex="1" parent="1" bang_du_lieu="lich_su_su_dung_huan_luyen_vien" unique_du_lieu="[[&quot;hoi_vien_id&quot;, &quot;huan_luyen_vien_id&quot;, &quot;ma_buoi_huan_luyen&quot;], [&quot;su_dung_quyen_loi_id&quot;]]" fk_kep_du_lieu="[{&quot;columns&quot;: [&quot;phan_cong_huan_luyen_vien_id&quot;, &quot;hoi_vien_id&quot;, &quot;huan_luyen_vien_id&quot;], &quot;table&quot;: &quot;phan_cong_huan_luyen_vien&quot;, &quot;target&quot;: [&quot;id&quot;, &quot;hoi_vien_id&quot;, &quot;huan_luyen_vien_id&quot;]}, {&quot;columns&quot;: [&quot;su_dung_quyen_loi_id&quot;, &quot;hoi_vien_id&quot;, &quot;ky_han_hoi_vien_id&quot;], &quot;table&quot;: &quot;su_dung_quyen_loi&quot;, &quot;target&quot;: [&quot;id&quot;, &quot;hoi_vien_id&quot;, &quot;ky_han_hoi_vien_id&quot;]}]" index_du_lieu="[[&quot;ky_han_hoi_vien_id&quot;, &quot;xac_nhan_luc&quot;], [&quot;huan_luyen_vien_id&quot;, &quot;xac_nhan_luc&quot;]]" tooltip="Ledger buổi PT hoàn thành; nguồn đối chiếu số lượt đã dùng của đúng kỳ.&#10;U1 = (hoi_vien_id, huan_luyen_vien_id, ma_buoi_huan_luyen)&#10;U2 = (su_dung_quyen_loi_id)&#10;FK kép: (phan_cong_huan_luyen_vien_id, hoi_vien_id, huan_luyen_vien_id) -&gt; phan_cong_huan_luyen_vien(id, hoi_vien_id, huan_luyen_vien_id)&#10;FK kép: (su_dung_quyen_loi_id, hoi_vien_id, ky_han_hoi_vien_id) -&gt; su_dung_quyen_loi(id, hoi_vien_id, ky_han_hoi_vien_id)&#10;CHECK cùng hàng: trang_thai=HOAN_THANH; so_luot_su_dung=1; hoan_thanh_luc &lt;= xac_nhan_luc.&#10;Index bổ sung: (ky_han_hoi_vien_id, xac_nhan_luc); (huan_luyen_vien_id, xac_nhan_luc)&#10;Snapshot/ledger append-only; không sửa/xóa hàng đã công bố. Không cần booking để tạo ledger. Hai request dùng lượt cuối khóa cùng kỳ. Ledger + counter + activation + audit ghi một transaction. Không tạo bảng chuyển lượt/hoàn lượt/điều chỉnh trong MVP. Buổi PT trực tiếp không đồng nhất với phien_tap. Xác nhận cần snapshot tổng buổi &gt; 0 và đã dùng &lt; tổng; không kiểm tra cờ Chat để cấp/trừ buổi. Gói chỉ Chat với tổng buổi=0 không được ghi ledger buổi PT. Q06 ĐÃ CHỐT: chỉ xác nhận hợp lệ khi đúng kỳ còn hiệu lực (hoặc head được phép kích hoạt), còn quota và phân công hợp lệ. Nếu kỳ của buổi đã hết trước xác nhận thì từ chối; hoan_thanh_luc không được dùng để backdate activation/trừ kỳ cũ hoặc mượn kỳ mới. Đối chiếu buổi với đúng kỳ, không chọn kỳ khác chỉ vì còn lượt. Q13 tạo/apply Proposal không tạo ledger này. Q12 không hard-delete; correction Admin là Future Development.">
          <mxGeometry x="40" y="90" width="420.0" height="287" as="geometry" />
        </mxCell>
