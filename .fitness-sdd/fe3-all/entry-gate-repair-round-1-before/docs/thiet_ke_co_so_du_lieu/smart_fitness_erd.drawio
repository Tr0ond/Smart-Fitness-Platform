  <diagram id="bang-20" name="B20 ma_vao_phong_tap">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0" trang_thai_thiet_ke="APPROVED_FOR_MIGRATION_PLANNING">
      <root>
