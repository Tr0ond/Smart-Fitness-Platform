        <mxCell id="31" value="ho_so_hoi_vien PK id • bảng tham chiếu" style="rounded=0;fillColor=#f3f6fa;strokeColor=#243b53;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
