        <mxCell id="q-col-phan_cong_huan_luyen_vien_id" value="FK phan_cong_huan_luyen_vien_id : BIGINT UNSIGNED [U1,U2]" style="rounded=0;strokeColor=none;fillColor=#f3f6fa;fontFamily=Consolas;fontSize=9;align=left;spacingLeft=7;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="4" bang_du_lieu="hoi_thoai" cot_du_lieu="phan_cong_huan_luyen_vien_id" kieu_du_lieu="BIGINT UNSIGNED" cho_phep_null="0" khoa_chinh="0" bang_tham_chieu="phan_cong_huan_luyen_vien" cot_sinh="" nhom_unique="[1, 2]" tooltip="BIGINT UNSIGNED; NOT NULL; FK -&gt; phan_cong_huan_luyen_vien.id; U1(phan_cong_huan_luyen_vien_id); U2(id, phan_cong_huan_luyen_vien_id)&#10;Lần phân công sở hữu hội thoại; UNIQUE, tối đa một hội thoại mỗi phân công. Không đổi FK khi đổi PT hoặc cấp lại phân công.">
          <mxGeometry x="0" y="81" width="420.0" height="15" as="geometry" />
        </mxCell>
