        </mxCell>
        <mxCell id="21" value="   ma_loi : VARCHAR(100) ?" style="rounded=0;strokeColor=none;fillColor=#f3f6fa;fontFamily=Consolas;fontSize=9;align=left;spacingLeft=7;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="4" bang_du_lieu="lan_thanh_toan" cot_du_lieu="ma_loi" kieu_du_lieu="VARCHAR(100)" cho_phep_null="1" khoa_chinh="0" bang_tham_chieu="" cot_sinh="" nhom_unique="[]" tooltip="VARCHAR(100); NULL; &#10;Mã lỗi được chuẩn hóa.">
          <mxGeometry x="0" y="261" width="420.0" height="15" as="geometry" />
        </mxCell>
        <mxCell id="22" value="   ngay_tao : DATETIME(6)" style="rounded=0;strokeColor=none;fillColor=#ffffff;fontFamily=Consolas;fontSize=9;align=left;spacingLeft=7;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="4" bang_du_lieu="lan_thanh_toan" cot_du_lieu="ngay_tao" kieu_du_lieu="DATETIME(6)" cho_phep_null="0" khoa_chinh="0" bang_tham_chieu="" cot_sinh="" nhom_unique="[]" tooltip="DATETIME(6); NOT NULL; &#10;Thời điểm tạo, UTC.">
          <mxGeometry x="0" y="276" width="420.0" height="15" as="geometry" />
