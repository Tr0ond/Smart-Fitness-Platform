        <mxCell id="7" value="FK hoi_vien_id : BIGINT UNSIGNED" style="rounded=0;strokeColor=none;fillColor=#f3f6fa;fontFamily=Consolas;fontSize=9;align=left;spacingLeft=7;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="4" bang_du_lieu="de_xuat_ke_hoach_tap" cot_du_lieu="hoi_vien_id" kieu_du_lieu="BIGINT UNSIGNED" cho_phep_null="0" khoa_chinh="0" bang_tham_chieu="ho_so_hoi_vien" cot_sinh="" nhom_unique="[]" tooltip="BIGINT UNSIGNED; NOT NULL; FK -&gt; ho_so_hoi_vien.id; &#10;Chủ đề xuất.">
