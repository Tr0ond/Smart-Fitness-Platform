        <mxCell id="17" value="U1..U1: cùng mã = cùng bộ UNIQUE. ? = NULL • G = VIRTUAL. Bộ cột/điều kiện ở ghi chú dưới." style="text;html=0;fontSize=8.5;fontColor=#52606d;align=left;" vertex="1" parent="4">
