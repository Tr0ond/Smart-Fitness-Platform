        <mxCell id="q-edge-phan_cong_huan_luyen_vien_id" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#73869a;strokeWidth=1;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jettySize=auto;" edge="1" parent="1" source="q-col-phan_cong_huan_luyen_vien_id" target="q-ref-phan_cong_huan_luyen_vien">
