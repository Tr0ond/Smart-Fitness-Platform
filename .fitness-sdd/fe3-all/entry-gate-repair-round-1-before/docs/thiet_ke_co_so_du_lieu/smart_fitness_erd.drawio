        <mxCell id="7" value="FK nguoi_dung_id : BIGINT UNSIGNED [U1]" style="rounded=0;strokeColor=none;fillColor=#f3f6fa;fontFamily=Consolas;fontSize=9;align=left;spacingLeft=7;whiteSpace=nowrap;overflow=hidden;" vertex="1" parent="4" bang_du_lieu="yeu_cau_chong_lap" cot_du_lieu="nguoi_dung_id" kieu_du_lieu="BIGINT UNSIGNED" cho_phep_null="0" khoa_chinh="0" bang_tham_chieu="nguoi_dung" cot_sinh="" nhom_unique="[1]" tooltip="BIGINT UNSIGNED; NOT NULL; FK -&gt; nguoi_dung.id; U1(nguoi_dung_id, pham_vi, khoa_yeu_cau)&#10;Scope người gọi.">
