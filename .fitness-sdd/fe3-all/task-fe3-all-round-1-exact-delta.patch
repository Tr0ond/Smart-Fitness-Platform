+export function laIdGoiTapHopLe(value) {
+  return (typeof value === 'number' && Number.isSafeInteger(value) && value > 0)
+    || (typeof value === 'string' && /^[1-9]\d*$/.test(value.trim()) && Number.isSafeInteger(Number(value.trim())))
+}
+
+function layId(value) {
