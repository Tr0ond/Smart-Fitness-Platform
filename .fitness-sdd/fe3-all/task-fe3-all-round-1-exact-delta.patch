+
+/* FE3 Admin Catalog: light staff surfaces, semantic states, and responsive forms. */
+.trang-danh-muc {
+  display: grid;
+  gap: 1.25rem;
+  min-width: 0;
+}
+
+.trang-danh-muc--form form,
+.trang-danh-muc__form {
+  display: grid;
+  gap: 1rem;
+}
+
+.trang-danh-muc__khung-hai-cot {
+  display: grid;
+  grid-template-columns: minmax(15rem, 22rem) minmax(0, 1fr);
+  gap: 1.25rem;
+  align-items: start;
+}
+
+.trang-danh-muc__form,
+.danh-muc-quyen-loi,
+.danh-muc-quan-he,
+.cay-giao-an,
+.trang-danh-muc__canh-bao {
+  border: 1px solid var(--mau-vien);
+  border-radius: var(--ban-kinh-lon, 0.75rem);
+  padding: 1rem;
+  background: var(--mau-nen-trang);
+}
+
+.trang-danh-muc__form h2,
+.danh-muc-quyen-loi legend,
+.danh-muc-quan-he legend,
+.cay-giao-an h2 {
+  margin: 0;
+  color: var(--mau-chu-chinh);
+  font-size: 1.05rem;
+  font-weight: 700;
+}
+
+.trang-danh-muc__hanh-dong,
+.cay-giao-an__dau,
+.cay-giao-an__ngay > header,
+.cay-giao-an__ngay li {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  align-items: center;
+}
+
+.trang-danh-muc__hanh-dong { justify-content: flex-end; }
+.trang-danh-muc__loi { color: var(--mau-nguy-hiem); }
+.trang-danh-muc__canh-bao { color: var(--mau-canh-bao); background: var(--mau-nen-canh-bao); }
+.trang-danh-muc__khung-hai-cot > div { min-width: 0; }
+
+.danh-muc-quyen-loi,
+.danh-muc-quan-he {
+  display: grid;
+  gap: 0.65rem;
+}
+
+.danh-muc-quyen-loi legend,
+.danh-muc-quan-he legend { padding: 0 0.25rem; }
+.danh-muc-quyen-loi label,
+.danh-muc-quan-he label { display: flex; gap: 0.5rem; align-items: center; }
+.danh-muc-quyen-loi input[type='number'] { max-width: 12rem; }
+.danh-muc-quyen-loi__goi-y,
+.danh-muc-quan-he__goi-y { margin: 0; color: var(--mau-chu-phu); font-size: 0.9rem; }
+.danh-muc-quyen-loi__canh-bao { margin: 0; color: var(--mau-canh-bao); font-size: 0.9rem; }
+.danh-muc-quan-he select[multiple] { min-height: 7rem; }
+.danh-muc-quan-he__nhan { font-weight: 700; }
+.danh-muc-quan-he__nhom-co { display: grid; gap: 0.5rem; }
+.danh-muc-quan-he__khong-hoat-dong { opacity: 0.7; }
+
+.cay-giao-an { display: grid; gap: 1rem; }
+.cay-giao-an__dau { justify-content: space-between; }
+.cay-giao-an__ngay { display: grid; gap: 0.75rem; padding: 0.9rem; border: 1px solid var(--mau-vien); border-radius: 0.5rem; background: var(--mau-nen-phu); }
+.cay-giao-an__ngay > header label { font-weight: 600; }
+.cay-giao-an__ngay > header input { min-width: 9rem; }
+.cay-giao-an__ngay ol { display: grid; gap: 0.65rem; margin: 0; padding-left: 1.5rem; }
+.cay-giao-an__ngay li { padding: 0.65rem; border: 1px solid var(--mau-vien); border-radius: 0.45rem; background: var(--mau-nen-trang); }
+.cay-giao-an__ngay li label { font-size: 0.85rem; color: var(--mau-chu-phu); }
+.cay-giao-an__rong { margin: 0; color: var(--mau-chu-phu); }
+
+.hop-thoai-xung-dot-giao-an { z-index: 20; }
+
+@media (max-width: 52rem) {
+  .trang-danh-muc__khung-hai-cot { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 30rem) {
+  .trang-danh-muc__hanh-dong .nut,
+  .cay-giao-an__dau .nut { width: 100%; }
+  .cay-giao-an__ngay > header,
+  .cay-giao-an__ngay li { align-items: stretch; }
+  .cay-giao-an__ngay > header > input,
+  .cay-giao-an__ngay > header > button,
+  .cay-giao-an__ngay li > input,
+  .cay-giao-an__ngay li > select,
+  .cay-giao-an__ngay li > button { width: 100%; }
+}
