        <mxCell id="bang-phien_tap" parent="1" style="shape=table;startSize=36;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=0;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontFamily=Arial;fontSize=14;" value="phien_tap" vertex="1" bang_du_lieu="phien_tap" unique_du_lieu="[[&quot;buoi_tap_du_kien_id&quot;], [&quot;hoi_vien_id&quot;, &quot;ma_lan_bat_dau&quot;], [&quot;hoi_vien_id&quot;, &quot;ma_lan_hoan_thanh&quot;], [&quot;id&quot;, &quot;hoi_vien_id&quot;]]" fk_kep_du_lieu="[{&quot;columns&quot;: [&quot;buoi_tap_du_kien_id&quot;, &quot;hoi_vien_id&quot;], &quot;table&quot;: &quot;buoi_tap_du_kien&quot;, &quot;target&quot;: [&quot;id&quot;, &quot;hoi_vien_id&quot;]}]" index_du_lieu="[[&quot;hoi_vien_id&quot;, &quot;bat_dau_luc&quot;, &quot;id&quot;], [&quot;hoi_vien_id&quot;, &quot;trang_thai&quot;]]" tooltip="Workout Session thực tế; HOAN_THANH là mốc khóa toàn bộ kết quả và các bảng con.&#10;U1 = (buoi_tap_du_kien_id)&#10;U2 = (hoi_vien_id, ma_lan_bat_dau)&#10;U3 = (hoi_vien_id, ma_lan_hoan_thanh)&#10;U4 = (id, hoi_vien_id)&#10;FK kép: (buoi_tap_du_kien_id, hoi_vien_id) -&gt; buoi_tap_du_kien(id, hoi_vien_id)&#10;CHECK cùng hàng: ket_thuc_luc NULL hoặc &gt;= bat_dau_luc; HOAN_THANH =&gt; kết thúc và mã hoàn thành không NULL.&#10;Index bổ sung: (hoi_vien_id, bat_dau_luc, id); (hoi_vien_id, trang_thai)&#10;Q07C/D ĐÃ CHỐT: buoi_tap_du_kien_id NOT NULL UNIQUE, một lịch tối đa một phiên kể cả phiên HUY. Không restart/chuyển HUY về DANG_TAP, không thêm phiên thứ hai hoặc xóa phiên HUY để thử lại. Nếu tập lại, dùng buoi_tap_du_kien thay thế theo workflow schedule/version hợp lệ, giữ phiên/FK cũ; không tạo Free Workout hay lịch giả. Q08: Start/Save Set/Complete không yêu cầu Membership còn hiệu lực, không tạo usage trả phí hoặc kích hoạt kỳ; vẫn xác thực Member, ownership, Plan/Schedule/trạng thái, idempotency và concurrency. Mọi ghi set/complete khóa hội viên/phiên cha; HOAN_THANH cấm sửa/xóa cả cây kết quả. Q12: giữ lịch sử cả phiên HUY và HOAN_THANH.">
          <mxGeometry height="348" width="360" x="96" y="3840" as="geometry" />
        </mxCell>
