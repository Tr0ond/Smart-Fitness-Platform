              <mxPoint x="480" y="2352" />
              <mxPoint x="480" y="2256" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="q-quyet-dinh" parent="1" vertex="1" value="Q03: 1 request AI hợp lệ = 1 lượt; giữ chỗ trước provider, commit rồi gọi. Retry provider không thêm; lỗi kỹ thuật trả 1 quota, không rollback activation. Request bị từ chối trước chấp nhận không quota/usage/activation.&#10;Q13: PT Proposal chỉ cần phân công hợp lệ, không Chat/quota/active Membership; confirm kiểm tra lại phân công nguồn, hết hiệu lực -&gt; XUNG_DOT. Q09: Proposal AI/PT 24 giờ, preview/retry không gia hạn. Q11: dụng cụ AND." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontColor=#172b4d;">
          <mxGeometry x="96" y="2844" width="1560" height="108" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
