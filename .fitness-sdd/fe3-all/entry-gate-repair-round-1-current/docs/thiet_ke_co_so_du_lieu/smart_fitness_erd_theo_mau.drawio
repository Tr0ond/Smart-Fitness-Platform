        <mxCell id="bang-su_dung_quyen_loi" parent="1" style="shape=table;startSize=36;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=0;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontFamily=Arial;fontSize=14;" value="su_dung_quyen_loi" vertex="1" bang_du_lieu="su_dung_quyen_loi" unique_du_lieu="[[&quot;hoi_vien_id&quot;, &quot;loai_su_dung&quot;, &quot;ma_hanh_dong&quot;], [&quot;id&quot;, &quot;hoi_vien_id&quot;, &quot;ky_han_hoi_vien_id&quot;], [&quot;id&quot;, &quot;hoi_vien_id&quot;]]" fk_kep_du_lieu="[{&quot;columns&quot;: [&quot;ky_han_hoi_vien_id&quot;, &quot;hoi_vien_id&quot;], &quot;table&quot;: &quot;ky_han_hoi_vien&quot;, &quot;target&quot;: [&quot;id&quot;, &quot;hoi_vien_id&quot;]}]" index_du_lieu="[[&quot;ky_han_hoi_vien_id&quot;, &quot;loai_su_dung&quot;, &quot;chap_nhan_luc&quot;]]" tooltip="Dấu vết một hành động trả phí được chấp nhận; nguồn kích hoạt và liên kết QR/PT/Chat/AI.&#10;U1 = (hoi_vien_id, loai_su_dung, ma_hanh_dong)&#10;U2 = (id, hoi_vien_id, ky_han_hoi_vien_id)&#10;U3 = (id, hoi_vien_id)&#10;FK kép: (ky_han_hoi_vien_id, hoi_vien_id) -&gt; ky_han_hoi_vien(id, hoi_vien_id)&#10;CHECK cùng hàng: Theo kiểu, NOT NULL, tập trạng thái/cờ nêu trong mô tả; chỉ áp dụng ràng buộc nghiệp vụ đã được chốt.&#10;Index bổ sung: (ky_han_hoi_vien_id, loai_su_dung, chap_nhan_luc)&#10;Snapshot/ledger append-only; không sửa/xóa hàng đã công bố. Chỉ ghi sau khi đủ quyền, ownership, quota và điều kiện luồng. Bản ghi domain tham chiếu hàng này bằng FK UNIQUE; không tạo cho việc chỉ mở màn hình/đọc lịch sử. Nguồn kích hoạt chuỗi phải thuộc kỳ thứ nhất của chính chuỗi, kiểm tra trong transaction. Riêng TRO_CHUYEN_HUAN_LUYEN chỉ ghi cho tin Member thực sự kích hoạt kỳ đầu đang chờ. Chat khi kỳ đã hoạt động, dù là tin Chat đầu tiên sau AI/QR/buổi PT, không ghi thêm usage. Không tạo usage cho từng tin hoặc từng kỳ nối tiếp; dấu vết tin nằm ở tin_nhan. Không áp ngoại lệ này cho request AI tính quota hoặc ledger buổi PT.">
          <mxGeometry height="228" width="360" x="4296" y="1704" as="geometry" />
        </mxCell>
        <mxCell id="cot-su_dung_quyen_loi-0" parent="bang-su_dung_quyen_loi" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#ffffff;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#222222;" value="" vertex="1" bang_du_lieu="su_dung_quyen_loi" cot_du_lieu="id" kieu_du_lieu="BIGINT UNSIGNED" cho_phep_null="0" khoa_chinh="1" bang_tham_chieu="" cot_sinh="" nhom_unique="[2, 3]" tooltip="BIGINT UNSIGNED; NOT NULL; PK; U2(id, hoi_vien_id, ky_han_hoi_vien_id); U3(id, hoi_vien_id)&#10;Khóa chính tự tăng.">
