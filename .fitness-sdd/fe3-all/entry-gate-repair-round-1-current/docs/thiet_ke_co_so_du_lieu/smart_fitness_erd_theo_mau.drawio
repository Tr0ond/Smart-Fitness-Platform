  <diagram id="mau-chat" name="06 Chat">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="12" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1356" math="0" shadow="0" background="#ffffff" trang_thai_thiet_ke="APPROVED_FOR_MIGRATION_PLANNING">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tieu-de" value="SMART FITNESS PLATFORM — 06 · Realtime Chat PT" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="72" y="32" width="1656" height="42" as="geometry" />
        </mxCell>
        <mxCell id="chu-giai" value="PK: khóa chính · FK: khóa ngoại · G: cột sinh VIRTUAL · ○: có thể không có · |: một · chân quạ: nhiều. APPROVED FOR MIGRATION PLANNING; chưa tạo/chạy migration. UNIQUE/kiểu/NULL: xem tooltip và từ điển. Bảng xám chỉ là tham chiếu." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="72" y="82" width="1656" height="44" as="geometry" />
        </mxCell>
        <mxCell id="nhom-0" value="Tham chiếu đến bảng thuộc nhóm khác (chỉ hiện khóa chính)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="96" y="744" width="1560" height="36" as="geometry" />
        </mxCell>
        <mxCell id="bang-hoi_thoai" value="hoi_thoai" style="shape=table;startSize=36;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=0;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontFamily=Arial;fontSize=14;" vertex="1" parent="1" bang_du_lieu="hoi_thoai" unique_du_lieu="[[&quot;phan_cong_huan_luyen_vien_id&quot;], [&quot;id&quot;, &quot;phan_cong_huan_luyen_vien_id&quot;]]" fk_kep_du_lieu="[{&quot;columns&quot;: [&quot;phan_cong_huan_luyen_vien_id&quot;, &quot;hoi_vien_id&quot;, &quot;huan_luyen_vien_id&quot;], &quot;table&quot;: &quot;phan_cong_huan_luyen_vien&quot;, &quot;target&quot;: [&quot;id&quot;, &quot;hoi_vien_id&quot;, &quot;huan_luyen_vien_id&quot;]}]" index_du_lieu="[[&quot;hoi_vien_id&quot;, &quot;ngay_cap_nhat&quot;], [&quot;huan_luyen_vien_id&quot;, &quot;ngay_cap_nhat&quot;]]" tooltip="Hội thoại 1–1 Member/PT của một lần phân công; giữ lịch sử đọc sau khi quan hệ kết thúc.&#10;U1 = (phan_cong_huan_luyen_vien_id)&#10;U2 = (id, phan_cong_huan_luyen_vien_id)&#10;FK kép: (phan_cong_huan_luyen_vien_id, hoi_vien_id, huan_luyen_vien_id) -&gt; phan_cong_huan_luyen_vien(id, hoi_vien_id, huan_luyen_vien_id)&#10;CHECK cùng hàng: Con trỏ đã đọc không âm và &lt;= so_thu_tu_cuoi.&#10;Index bổ sung: (hoi_vien_id, ngay_cap_nhat); (huan_luyen_vien_id, ngay_cap_nhat)&#10;Q05 ĐÃ CHỐT: phân biệt READ HISTORY với SEND NEW MESSAGE. Member đọc lịch sử của mình dù hết Membership hoặc phân công kết thúc. Gửi mới cần cờ Chat của kỳ hợp lệ và chính lần phân công của hội thoại còn hiệu lực; PT cũ không được gửi hoặc tiếp tục truy cập theo resource scope đã mất. Đổi PT dùng hội thoại của phân công mới; PT mới không đọc hội thoại cũ. FK phân công + UNIQUE thay UNIQUE cặp Member/PT để hội thoại đã kết thúc không mở lại khi Member quay lại PT cũ: lần phân công mới có hội thoại mới, không đổi chủ hội thoại cũ. Đây là hệ quả bảo toàn hội thoại lịch sử, không thêm bảng/group chat. Không DELETE/sửa nội dung tin; hết kỳ chỉ khóa gửi, không khóa Member đọc lịch sử. Read status là cột hỗ trợ tùy chọn.">
          <mxGeometry x="96" y="240" width="360" height="252" as="geometry" />
        </mxCell>
        <mxCell id="cot-hoi_thoai-0" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#ffffff;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#222222;" vertex="1" parent="bang-hoi_thoai" bang_du_lieu="hoi_thoai" cot_du_lieu="id" kieu_du_lieu="BIGINT UNSIGNED" cho_phep_null="0" khoa_chinh="1" bang_tham_chieu="" cot_sinh="" nhom_unique="[2]" tooltip="BIGINT UNSIGNED; NOT NULL; PK; U2(id, phan_cong_huan_luyen_vien_id)&#10;Khóa chính tự tăng.">
