        <mxCell id="bang-hoi_thoai" parent="1" style="shape=table;startSize=36;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=0;fillColor=#ffffff;strokeColor=#222222;fontColor=#111111;fontFamily=Arial;fontSize=14;" value="hoi_thoai" vertex="1" bang_du_lieu="hoi_thoai" unique_du_lieu="[[&quot;phan_cong_huan_luyen_vien_id&quot;], [&quot;id&quot;, &quot;phan_cong_huan_luyen_vien_id&quot;]]" fk_kep_du_lieu="[{&quot;columns&quot;: [&quot;phan_cong_huan_luyen_vien_id&quot;, &quot;hoi_vien_id&quot;, &quot;huan_luyen_vien_id&quot;], &quot;table&quot;: &quot;phan_cong_huan_luyen_vien&quot;, &quot;target&quot;: [&quot;id&quot;, &quot;hoi_vien_id&quot;, &quot;huan_luyen_vien_id&quot;]}]" index_du_lieu="[[&quot;hoi_vien_id&quot;, &quot;ngay_cap_nhat&quot;], [&quot;huan_luyen_vien_id&quot;, &quot;ngay_cap_nhat&quot;]]" tooltip="Hội thoại 1–1 Member/PT của một lần phân công; giữ lịch sử đọc sau khi quan hệ kết thúc.&#10;U1 = (phan_cong_huan_luyen_vien_id)&#10;U2 = (id, phan_cong_huan_luyen_vien_id)&#10;FK kép: (phan_cong_huan_luyen_vien_id, hoi_vien_id, huan_luyen_vien_id) -&gt; phan_cong_huan_luyen_vien(id, hoi_vien_id, huan_luyen_vien_id)&#10;CHECK cùng hàng: Con trỏ đã đọc không âm và &lt;= so_thu_tu_cuoi.&#10;Index bổ sung: (hoi_vien_id, ngay_cap_nhat); (huan_luyen_vien_id, ngay_cap_nhat)&#10;Q05 ĐÃ CHỐT: phân biệt READ HISTORY với SEND NEW MESSAGE. Member đọc lịch sử của mình dù hết Membership hoặc phân công kết thúc. Gửi mới cần cờ Chat của kỳ hợp lệ và chính lần phân công của hội thoại còn hiệu lực; PT cũ không được gửi hoặc tiếp tục truy cập theo resource scope đã mất. Đổi PT dùng hội thoại của phân công mới; PT mới không đọc hội thoại cũ. FK phân công + UNIQUE thay UNIQUE cặp Member/PT để hội thoại đã kết thúc không mở lại khi Member quay lại PT cũ: lần phân công mới có hội thoại mới, không đổi chủ hội thoại cũ. Đây là hệ quả bảo toàn hội thoại lịch sử, không thêm bảng/group chat. Không DELETE/sửa nội dung tin; hết kỳ chỉ khóa gửi, không khóa Member đọc lịch sử. Read status là cột hỗ trợ tùy chọn.">
          <mxGeometry height="252" width="360" x="3696" y="2640" as="geometry" />
        </mxCell>
