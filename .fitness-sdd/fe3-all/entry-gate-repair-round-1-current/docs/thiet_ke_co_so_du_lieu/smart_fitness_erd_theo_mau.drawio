        <mxCell id="tieu-de" value="SMART FITNESS PLATFORM — 08 · Nhật ký &amp; chống lặp" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
